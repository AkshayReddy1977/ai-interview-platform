# =========================================
# AI Interview Platform — Environment Variables
# Copy this file to server/.env and fill in real values.
# NEVER commit the actual .env file.
# =========================================

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/ai-interview-platform?retryWrites=true&w=majority

# --- JWT Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- AI / LLM Provider ---
# The AIService abstraction reads these; swap provider without touching business logic.
AI_PROVIDER=anthropic
AI_API_KEY=your_llm_api_key_here
AI_MODEL=claude-sonnet-4-6
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector Store ---
# Default implementation uses MongoDB Atlas Vector Search (same cluster as MONGODB_URI).
# Swappable later: set VECTOR_DB_PROVIDER=pinecone|qdrant and add matching keys.
VECTOR_DB_PROVIDER=mongodb-atlas
VECTOR_DATABASE_URL=
VECTOR_DATABASE_API_KEY=

# --- Object Storage (resumes, job docs, study PDFs) ---
STORAGE_PROVIDER=s3
STORAGE_URL=https://<account-id>.r2.cloudflarestorage.com
STORAGE_BUCKET=ai-interview-platform-files
STORAGE_ACCESS_KEY_ID=your_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
STORAGE_REGION=auto

# --- Redis (caching, rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging ---
LOG_LEVEL=info
